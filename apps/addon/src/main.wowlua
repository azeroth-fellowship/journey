  [97197] = "Fragment of the Firelands",
  [97198] = "Blackmaw Magic",
  [97288] = "Unending Torment",
  [97289] = "Unending Torment",
  [97291] = "Unending Torment",
  [97292] = "Unending Torment",
  [98815] = "Highland Hides",
  [98823] = "Earthen Echo",
  [98824] = "Prehistoric Prism",
}
-- END GENERATED QUESTS

-- Whether the client says a quest was ever turned in. Modern clients have C_QuestLog.IsQuestFlaggedCompleted, some
-- have the global, old ones GetQuestsCompleted() (a table of id -> true). Returns nil when the client cannot tell.
local function completedLookup(): any
  local cq = _G.C_QuestLog
  if type(cq) == "table" and type(cq.IsQuestFlaggedCompleted) == "function" then
    return function(id: number): boolean
      local ok, r = pcall(cq.IsQuestFlaggedCompleted, id)
      return ok and r == true
    end
  end
  if type(_G.IsQuestFlaggedCompleted) == "function" then
    return function(id: number): boolean
      local ok, r = pcall(_G.IsQuestFlaggedCompleted, id)
      return ok and r == true
    end
  end
  if type(_G.GetQuestsCompleted) == "function" then
    local ok, done = pcall(_G.GetQuestsCompleted)
    if ok and type(done) == "table" then
      return function(id: number): boolean return done[id] == true end
    end
  end
  return nil
end

-- One quest_completed event (backfilled = true) per catalog quest the client reports as done and the addon has not
-- reported yet. The server counts them toward dungeon progress only; they are not a timeline entry or session count.
-- Remembered per character, so each quest is sent once. Safe to call repeatedly: quest data can arrive after login.
local function backfillQuests()
  if not state.characterId or not state.sessionId then return end
  local isDone = completedLookup()
  if not isDone then return end
  local db = _G.AzerothJourneyDB
  db.backfilled = db.backfilled or {}
  local seen = db.backfilled[state.characterId] or {}
  db.backfilled[state.characterId] = seen
  for id, title in pairs(BACKFILL_QUESTS) do
    local key = tostring(id)
    if not seen[key] and isDone(id) then
      seen[key] = true
      pushEvent("quest_completed", { questId = key, questName = title, backfilled = true })
    end
  end
end

@event("QUEST_TURNED_IN")
local function onQuestTurnedIn(questId: any, xpReward: any)
  local payload: any = { questId = tostring(questId), questName = questTitle(questId), zone = zoneName(), xpGained = xpReward }
  local inst = state.instance
  if inst then
    payload.dungeonId = inst.id
    payload.dungeonName = inst.name
    payload.instanceKind = inst.instanceKind
  end
  pushEvent("quest_completed", payload)
  local db = _G.AzerothJourneyDB
  if state.characterId and type(db.backfilled) == "table" then
    db.backfilled[state.characterId] = db.backfilled[state.characterId] or {}
    db.backfilled[state.characterId][tostring(questId)] = true
  end
end

-- Events that only some clients have. RegisterEvent is pcall'd (some clients raise on unknown events), but others
-- accept any name silently, so a registration succeeding proves nothing; handlers tolerate never being called.
local optional = CreateFrame("Frame")

local function tryRegister(eventName: string)
  pcall(function() optional:RegisterEvent(eventName) end)
end

-- EXPERIMENTAL fallback for clients without BOSS_KILL / ENCOUNTER_END (the encounter API is the hint they exist):
-- a unit that dies while it can be seen as a "boss" unit counts as a boss kill. The dead unit is matched by GUID
-- against boss1-4/target/focus/mouseover; boss = classification "worldboss", or "elite" with level -1 (??).
-- Misses bosses nobody targets, and what counts as a boss may be different in this client.
local BOSS_TOKENS = { "boss1", "boss2", "boss3", "boss4", "target", "focus", "mouseover" }

local function bossNameForGuid(guid: any): string?
  if not guid then return nil end
  for _, token in ipairs(BOSS_TOKENS) do
    local g = call("UnitGUID", token)
    if g and g == guid then
      local class = call("UnitClassification", token)
      local isBoss = class == "worldboss" or (class == "elite" and call("UnitLevel", token) == -1)
      if not isBoss then return nil end
      return (call("UnitName", token))
    end
  end
  return nil
end

local function onCombatLog()
  if not state.instance then return end
  local gci = _G.CombatLogGetCurrentEventInfo
  if type(gci) ~= "function" then return end
  local ok, _, subevent, _, _, _, _, _, destGuid = pcall(gci)
  if not ok then return end
  if subevent ~= "UNIT_DIED" and subevent ~= "PARTY_KILL" then return end
  bossKilled(bossNameForGuid(destGuid), nil)
end

local encounterEventsLikely = type(_G.IsEncounterInProgress) == "function" or type(_G.C_InstanceEncounter) == "table"

-- Quest data can arrive some time after login, so look again on the first few quest log updates (not on every one).
local backfillLooks = 0

optional:SetScript("OnEvent", function(self, ev, a1, a2, a3, a4, a5)
  if ev == "PLAYER_ENTERING_WORLD" then
    backfillQuests()
  elseif ev == "QUEST_ACCEPTED" or ev == "QUEST_LOG_UPDATE" then
    if ev == "QUEST_LOG_UPDATE" and backfillLooks < 3 then
      backfillLooks = backfillLooks + 1
      backfillQuests()
    end
    scanQuestLog()
  elseif ev == "QUEST_DETAIL" or ev == "QUEST_COMPLETE" then
    scanQuestLog()
    local getId, getTitle = _G.GetQuestID, _G.GetTitleText
    if type(getId) == "function" and type(getTitle) == "function" then rememberQuestTitle(getId(), getTitle()) end
  elseif ev == "BOSS_KILL" then
    bossKilled(a2, a1)
  elseif ev == "ENCOUNTER_END" then
    if a5 == 1 or a5 == true then bossKilled(a2, a1) end
  elseif ev == "COMBAT_LOG_EVENT_UNFILTERED" then
    onCombatLog()
  elseif ev == "SKILL_LINES_CHANGED" then
    saveProfile()
  elseif ev == "LFG_COMPLETION_REWARD" then
    -- GUESS: the dungeon finder's "dungeon complete" signal; a client without a finder never fires it.
    dungeonCompleted()
  end
end)
tryRegister("PLAYER_ENTERING_WORLD")
tryRegister("QUEST_ACCEPTED")
tryRegister("QUEST_LOG_UPDATE")
tryRegister("QUEST_DETAIL")
tryRegister("QUEST_COMPLETE")
tryRegister("BOSS_KILL")
tryRegister("ENCOUNTER_END")
tryRegister("LFG_COMPLETION_REWARD")
tryRegister("SKILL_LINES_CHANGED")
if not encounterEventsLikely then tryRegister("COMBAT_LOG_EVENT_UNFILTERED") end

-- Location sampling timer
local sampler = CreateFrame("Frame")
local elapsed = 0
local SAMPLE_INTERVAL = 60
sampler:SetScript("OnUpdate", function(self, dt)
  if not state.sessionId then return end
  elapsed = elapsed + dt
  if elapsed >= SAMPLE_INTERVAL then
    elapsed = 0
    local zone = zoneName()
    if zone then
      local x, y = playerPosition()
      pushEvent("location", { zone = zone, x = x, y = y })
    end
  end
end)