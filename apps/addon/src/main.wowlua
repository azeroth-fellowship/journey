-- SPDX-License-Identifier: GPL-3.0-only
-- AzerothJourney addon: captures journey events into SavedVariables.
-- Built with wowlua (camelot flavor). See project brief Phase 5.

import addon from "wowlua:meta"
import event from "wowlua:events"
import print as chat from "wowlua:log"

-- SavedVariables table (persisted by the client across sessions/reloads)
_G.AzerothJourneyDB = _G.AzerothJourneyDB or { events = {}, sessions = {}, version = 1 }

local state: any = {
  characterId = nil,
  sessionId = nil,
  sessionStartedAt = nil,
  currentZone = nil,
  currentLevel = nil,
  -- The dungeon/raid instance the player is inside right now: { id, name, enteredAt, difficulty, bosses, completed }.
  instance = nil,
}

local function nowIso(): string
  return date("!%Y-%m-%dT%H:%M:%SZ", time())
end

-- GetZoneText is empty until the client has loaded the area (it is at PLAYER_LOGIN), so fall back and let callers omit it.
local function zoneName(): string?
  local z = GetZoneText()
  if type(z) == "string" and z ~= "" then return z end
  local real = _G.GetRealZoneText
  if type(real) == "function" then
    local r = real()
    if type(r) == "string" and r ~= "" then return r end
  end
  return nil
end

-- Player position on the current map as 0..1 fractions, or nil. Modern clients have C_Map; old ones GetPlayerMapPosition.
local function playerPosition(): (number?, number?)
  local x, y = nil, nil
  local cmap = _G.C_Map
  if type(cmap) == "table" and type(cmap.GetBestMapForUnit) == "function" and type(cmap.GetPlayerMapPosition) == "function" then
    pcall(function()
      local mapId = cmap.GetBestMapForUnit("player")
      if not mapId then return end
      local pos = cmap.GetPlayerMapPosition(mapId, "player")
      if pos then x, y = pos:GetXY() end
    end)
  end
  if x == nil and type(_G.GetPlayerMapPosition) == "function" then
    pcall(function() x, y = _G.GetPlayerMapPosition("player") end)
  end
  if type(x) ~= "number" or type(y) ~= "number" then return nil, nil end
  if (x == 0 and y == 0) or x < 0 or x > 1 or y < 0 or y > 1 then return nil, nil end
  return x, y
end

local function newEventId(): string
  local count = (_G.AzerothJourneyDB.events and #_G.AzerothJourneyDB.events or 0) + 1
  return format("evt-%s-%d", state.sessionId or "none", count)
end

local function pushEvent(typ: string, payload: any)
  if not state.characterId then return end
  local ev = {
    id = newEventId(),
    characterId = state.characterId,
    sessionId = state.sessionId,
    occurredAt = nowIso(),
    type = typ,
    source = "addon",
    payload = payload or {},
  }
  _G.AzerothJourneyDB.events = _G.AzerothJourneyDB.events or {}
  table.insert(_G.AzerothJourneyDB.events, ev)
end

-- ---------------------------------------------------------------------------
-- Dungeons
--
-- GUESSWORK: WoW Forever (release 2026-11-04) is not available, so every client API below is used defensively
-- (looked up in _G, called through pcall, nil-guarded) and none of it has run against the real client; only the
-- wowlua emulated client (tests/main.test.wowlua) has exercised it. Verify on launch day.
-- ---------------------------------------------------------------------------

-- Calls a global API if the client has it; nil results when it is missing or errors.
local function call(name: string, a: any?, b: any?): (any, any, any, any, any, any, any, any)
  local fn = _G[name]
  if type(fn) ~= "function" then return nil end
  local ok, r1, r2, r3, r4, r5, r6, r7, r8 = pcall(fn, a, b)
  if not ok then return nil end
  return r1, r2, r3, r4, r5, r6, r7, r8
end

local function slug(name: string): string
  local s = string.lower(name)
  s = (string.gsub(s, "[^%w]+", "-"))
  s = (string.gsub(s, "^%-+", ""))
  s = (string.gsub(s, "%-+$", ""))
  return s
end

-- dungeonId is the instance id (GetInstanceInfo's 8th return, a client-wide stable map id) as a string, e.g. "36".
-- When the client reports none, the slugged name is used instead ("name:deadmines"): stable for one client
-- language, but it differs from the id form, so a character that switches between the two shows up as two dungeons.
local function dungeonIdOf(name: string, instanceId: any): string
  if type(instanceId) == "number" and instanceId > 0 then return tostring(instanceId) end
  return "name:" .. slug(name)
end

-- Dungeons and raids only; battlegrounds, arenas and scenarios are not dungeon progress.
local function readInstance(): any
  local inside, kind = call("IsInInstance")
  if not inside then return nil end
  local name, instanceType, _, difficultyName, _, _, _, instanceId = call("GetInstanceInfo")
  kind = instanceType or kind
  if kind ~= "party" and kind ~= "raid" then return nil end
  if type(name) ~= "string" or name == "" then return nil end
  local difficulty = nil
  if type(difficultyName) == "string" and difficultyName ~= "" then difficulty = difficultyName end
  return { id = dungeonIdOf(name, instanceId), name = name, difficulty = difficulty, kind = kind, instanceKind = (kind == "raid") and "raid" or "dungeon" }
end

local function groupSize(): number?
  local n = call("GetNumGroupMembers")
  if type(n) ~= "number" then
    local party = call("GetNumPartyMembers")
    if type(party) == "number" then n = party + 1 end
  end
  if type(n) ~= "number" then return nil end
  if n < 1 then n = 1 end
  return n
end

-- The open instance survives /reload and logout in the SavedVariables (per character), so a reload inside a dungeon
-- does not look like leaving and re-entering it.
local function saveInstance()
  _G.AzerothJourneyDB.activeInstances = _G.AzerothJourneyDB.activeInstances or {}
  local cur = state.instance
  _G.AzerothJourneyDB.activeInstances[state.characterId] = cur and { id = cur.id, name = cur.name, enteredAt = cur.enteredAt, instanceKind = cur.instanceKind } or nil
end

-- Raids have their own event types (raid_entered / raid_left / raid_completed); everything else about them is the same.
local function instanceEvent(inst: any, dungeonType: string, raidType: string): string
  if inst and inst.instanceKind == "raid" then return raidType end
  return dungeonType
end

local function leaveInstance(prev: any, withDuration: boolean)
  local payload: any = { dungeonId = prev.id, dungeonName = prev.name, instanceKind = prev.instanceKind }
  if withDuration and type(prev.enteredAt) == "number" then
    payload.durationSeconds = math.max(0, time() - prev.enteredAt)
  end
  pushEvent(instanceEvent(prev, "dungeon_left", "raid_left"), payload)
end

-- Compares where the player is with what we last knew and emits dungeon_entered / dungeon_left.
local function syncInstance()
  if not state.characterId then return end
  local cur = readInstance()
  local prev = state.instance
  if prev and cur and prev.id == cur.id then return end
  if prev then
    leaveInstance(prev, true)
    state.instance = nil
  end
  local saved = _G.AzerothJourneyDB.activeInstances and _G.AzerothJourneyDB.activeInstances[state.characterId]
  if cur then
    if saved and saved.id == cur.id and not prev then
      -- reload / relog inside the same instance: resume, do not announce it again
      cur.enteredAt = saved.enteredAt
    else
      if saved and not prev then leaveInstance(saved, false) end -- the session ended inside another instance
      cur.enteredAt = time()
      pushEvent(instanceEvent(cur, "dungeon_entered", "raid_entered"), { dungeonId = cur.id, dungeonName = cur.name, difficulty = cur.difficulty, partySize = groupSize(), instanceKind = cur.instanceKind })
    end
    cur.bosses = {}
    state.instance = cur
  elseif saved and not prev then
    leaveInstance(saved, false) -- logged out inside, back in the open world now
  end
  saveInstance()
end

-- One kill per boss name per visit (BOSS_KILL, ENCOUNTER_END and the combat-log fallback may all report it).
local function bossKilled(name: any, encounterId: any)
  local inst = state.instance
  if not inst or type(name) ~= "string" or name == "" then return end
  local key = string.lower(name)
  if inst.bosses[key] then return end
  inst.bosses[key] = true
  local payload: any = { dungeonId = inst.id, dungeonName = inst.name, bossName = name, instanceKind = inst.instanceKind }
  if encounterId ~= nil then payload.encounterId = tostring(encounterId) end
  pushEvent("boss_killed", payload)
end

-- Only an explicit completion signal from the client counts; the API/web derive "completed" from boss kills otherwise.
local function dungeonCompleted()
  local inst = state.instance
  if not inst or inst.completed then return end
  inst.completed = true
  pushEvent(instanceEvent(inst, "dungeon_completed", "raid_completed"), { dungeonId = inst.id, dungeonName = inst.name, difficulty = inst.difficulty, instanceKind = inst.instanceKind })
end

local function startSession()
  state.sessionId = format("sess-%s-%s", state.characterId or "x", nowIso())
  state.sessionStartedAt = nowIso()
  state.currentZone = zoneName()
  state.currentLevel = UnitLevel("player")
  pushEvent("session_started", { zone = state.currentZone, level = state.currentLevel })
end

-- /reload fires PLAYER_LOGOUT too, and the client does not say which one it is. The end event is written at logout, and a
-- login of the same character within RELOAD_WINDOW seconds takes it back and carries on with the same session instead.
local RELOAD_WINDOW = 30

local function endSession(reason: string?)
  if not state.sessionId then return end
  pushEvent("session_ended", { reason = reason or "logout", zone = zoneName() or state.currentZone, level = state.currentLevel or UnitLevel("player") })
  local events = _G.AzerothJourneyDB.events
  local last = events[#events]
  _G.AzerothJourneyDB.lastEnd = last and { characterId = state.characterId, sessionId = state.sessionId, eventId = last.id, at = time(), startedAt = state.sessionStartedAt, zone = state.currentZone, level = state.currentLevel } or nil
  state.sessionId = nil
end

-- Takes the pending end back after a reload; false when this is a fresh login.
local function resumeSession(): boolean
  local pending = _G.AzerothJourneyDB.lastEnd
  _G.AzerothJourneyDB.lastEnd = nil
  if not pending or pending.characterId ~= state.characterId then return false end
  if type(pending.at) ~= "number" or time() - pending.at > RELOAD_WINDOW then return false end
  local events = _G.AzerothJourneyDB.events
  local last = events[#events]
  if not last or last.id ~= pending.eventId or last.type ~= "session_ended" then return false end
  table.remove(events)
  state.sessionId = pending.sessionId
  state.sessionStartedAt = pending.startedAt
  state.currentZone = pending.zone
  state.currentLevel = UnitLevel("player") or pending.level
  return true
end

-- Professions: { name, rank, max, icon?, skillLine? } per primary/secondary profession, saved on the character record.
-- Clients with GetProfessions give icon and skill line id; older ones only list skills by (localized) name, so those are
-- matched against the English profession names and anything else is skipped.
local PROFESSION_NAMES: any = {
  Alchemy = true, Blacksmithing = true, Enchanting = true, Engineering = true, Herbalism = true, Inscription = true,
  Jewelcrafting = true, Leatherworking = true, Mining = true, Skinning = true, Tailoring = true,
  Cooking = true, ["First Aid"] = true, Fishing = true, Archaeology = true, Lockpicking = true,
}

local function readProfessions(): any
  local out: any = {}
  local gp, gi = _G.GetProfessions, _G.GetProfessionInfo
  if type(gp) == "function" and type(gi) == "function" then
    local ok = pcall(function()
      local a, b, c, d, e, f = gp()
      local idx = { a, b, c, d, e, f }
      for i = 1, 6 do
        if idx[i] then
          local name, icon, rank, maxRank, _, _, skillLine = gi(idx[i])
          if type(name) == "string" and type(rank) == "number" then
            table.insert(out, { name = name, rank = rank, max = maxRank, icon = icon, skillLine = skillLine })
          end
        end
      end
    end)
    if ok then return out end
    out = {}
  end
  local num, info = _G.GetNumSkillLines, _G.GetSkillLineInfo
  if type(num) ~= "function" or type(info) ~= "function" then return out end
  pcall(function()
    -- Skills under a collapsed header are not listed: open them all, read, then collapse the ones that were closed.
    local closed: any = {}
    local expand, collapse = _G.ExpandSkillHeader, _G.CollapseSkillHeader
    if type(expand) == "function" and type(collapse) == "function" then
      for i = 1, num() do
        local _, header, isExpanded = info(i)
        if header and not isExpanded then table.insert(closed, i) end
      end
      expand(0)
    end
    for i = 1, num() do
      local name, header, _, rank, _, _, maxRank = info(i)
      if not header and PROFESSION_NAMES[name] and type(rank) == "number" then
        table.insert(out, { name = name, rank = rank, max = maxRank })
      end
    end
    if type(collapse) == "function" then
      for i = #closed, 1, -1 do collapse(closed[i]) end
    end
  end)
  return out
end

-- UnitSex: 2 = male, 3 = female (1 = unknown).
local function genderToken(): string?
  local sex = call("UnitSex", "player")
  if sex == 2 then return "male" end
  if sex == 3 then return "female" end
  return nil
end

local function saveProfile()
  local meta = _G.AzerothJourneyDB.characters and _G.AzerothJourneyDB.characters[state.characterId]
  if not meta then return end
  local list = readProfessions()
  -- Some clients answer with nothing right at login; keep what we had rather than blanking it.
  if #list > 0 or meta.professions == nil then meta.professions = list end
  meta.gender = genderToken() or meta.gender
end

@event("PLAYER_LOGIN")
local function onLogin()
  -- UnitName returns no realm for a same-realm player, so ask for the realm explicitly.
  local name = UnitName("player")
  local realm = GetRealmName()
  state.characterId = format("%s-%s", name or "unknown", realm or "realm")
  -- Identity the companion needs to register the character (class/race are the stable English tokens).
  local _, classFile = UnitClass("player")
  local _, raceFile = UnitRace("player")
  _G.AzerothJourneyDB.characters = _G.AzerothJourneyDB.characters or {}
  _G.AzerothJourneyDB.characters[state.characterId] = {
    name = name, realm = realm, class = classFile, race = raceFile, level = UnitLevel("player"),
  }
  if not resumeSession() then startSession() end
  saveProfile()
  chat(format("%s loaded", addon.title))
end

@event("PLAYER_LOGOUT")
local function onLogout()
  endSession("logout")
end

@event("PLAYER_LEVEL_UP")
local function onLevelUp(newLevel: number)
  local from = state.currentLevel or (newLevel - 1)
  state.currentLevel = newLevel
  pushEvent("level_up", { fromLevel = from, toLevel = newLevel, zone = zoneName() })
end

@event("PLAYER_ENTERING_WORLD")
local function onEnteringWorld()
  -- the zone was not known yet when the session started at PLAYER_LOGIN
  local zone = zoneName()
  if zone and not state.currentZone and state.sessionId then
    state.currentZone = zone
    local events = _G.AzerothJourneyDB.events
    for i = #events, 1, -1 do
      local e = events[i]
      if e.sessionId ~= state.sessionId then break end
      if e.type == "session_started" then
        e.payload.zone = zone
        break
      end
    end
  end
  syncInstance()
  saveProfile()
end

-- Continents and zones count as "big" zones; dungeons (4), micro/sub areas (5) and orphans (6) do not. Clients without
-- C_Map cannot tell, and ZONE_CHANGED_NEW_AREA is already the major-zone event there, so they count as big.
local function isMajorZone(): boolean
  local cmap = _G.C_Map
  if type(cmap) ~= "table" or type(cmap.GetBestMapForUnit) ~= "function" or type(cmap.GetMapInfo) ~= "function" then return true end
  local major = true
  pcall(function()
    local mapId = cmap.GetBestMapForUnit("player")
    local info = mapId and cmap.GetMapInfo(mapId)
    if type(info) == "table" and type(info.mapType) == "number" and info.mapType > 3 then major = false end
  end)
  return major
end

@event("ZONE_CHANGED_NEW_AREA")
local function onZoneChanged()
  syncInstance()
  -- Inside a dungeon/raid the zone text is the instance; dungeon_entered / dungeon_left cover that. currentZone keeps the
  -- outdoor zone, so walking out into the same zone you walked in from is not a zone change either.
  if state.instance then return end
  if not isMajorZone() then return end
  local newZone = zoneName()
  if newZone and newZone ~= state.currentZone then
    -- With no previous zone this is the client announcing where the character logged in, not a journey.
    if state.currentZone then
      pushEvent("zone_changed", { fromZone = state.currentZone, toZone = newZone })
    end
    state.currentZone = newZone
  end
end

-- Quest titles: the quest log no longer has a quest once it is turned in, so remember the title from the quest dialog.
local questTitles: any = {}

local function rememberQuestTitle(id: any, title: any)
  if id and type(title) == "string" and title ~= "" then questTitles[tostring(id)] = title end
end

-- Remember the title of every quest in the log, so a quest that leaves the log when it is turned in still has a name.
-- Modern clients list the log through C_QuestLog, older ones through GetQuestLogTitle (quest id is its 8th result).
local function scanQuestLog()
  local cq = _G.C_QuestLog
  if type(cq) == "table" and type(cq.GetNumQuestLogEntries) == "function" and type(cq.GetInfo) == "function" then
    pcall(function()
      local n = cq.GetNumQuestLogEntries()
      for i = 1, n do
        local info = cq.GetInfo(i)
        if type(info) == "table" and not info.isHeader then rememberQuestTitle(info.questID, info.title) end
      end
    end)
    return
  end
  local count, title = _G.GetNumQuestLogEntries, _G.GetQuestLogTitle
  if type(count) ~= "function" or type(title) ~= "function" then return end
  pcall(function()
    local n = count()
    for i = 1, n do
      local t, _, _, isHeader, _, _, _, id = title(i)
      if not isHeader then rememberQuestTitle(id, t) end
    end
  end)
end

local function questTitle(questId: any): string
  local key = tostring(questId)
  local cq = _G.C_QuestLog
  if type(cq) == "table" and type(cq.GetTitleForQuestID) == "function" then
    local ok, t = pcall(cq.GetTitleForQuestID, questId)
    if ok and type(t) == "string" and t ~= "" then return t end
  end
  return questTitles[key] or ("Quest " .. key)
end

