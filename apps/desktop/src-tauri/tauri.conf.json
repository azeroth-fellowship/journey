{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azeroth Journey Companion",
  "version": "0.0.0",
  "identifier": "com.azeroth.journey.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Azeroth Journey Companion",
        "width": 440,
        "height": 760,
        "minWidth": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["azeroth-journey"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Azeroth Journey",
    "shortDescription": "Azeroth Journey desktop companion",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
